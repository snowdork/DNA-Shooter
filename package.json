{
  "name": "dna-shooter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.19"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/model.test.ts",
    "test:browser": "playwright test",
    "build": "npm run typecheck && vite build && node scripts/compress.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "verify": "npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
